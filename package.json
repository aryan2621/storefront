    "clsx": "2.1.1",
    "hono": "4.13.14",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
